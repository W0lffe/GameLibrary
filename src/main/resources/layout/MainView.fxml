<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="DatabaseProgramming.Gamelib.GUI.MainController"
            fx:id="root"
            styleClass="root">
            
    <top>
    	<HBox alignment="CENTER"
    			styleClass="container">
    		<Label text="Game Library (Database Programming 2026)" 
    				styleClass="title"/>
    	</HBox>
    </top>

    <left>
        <VBox fx:id="navigation"
              spacing="15"
              alignment="TOP_CENTER"
              styleClass="container">
              
	          <Label text="Navigation"
	          		styleClass="title"/>
	          		
	          <Label text=""
	          		styleClass="title"
	          		fx:id="userLabel"/>
	
			<VBox fx:id="navigation"
	              spacing="20"
	              alignment="TOP_CENTER"
	              style="-fx-padding: 20;">
	            
	            <Button text="Add Game"
			            fx:id="addGameBtn"
			            onAction="#handleAddGame"
			            styleClass="button"/>
		
			    <Button text="My Games"
			            fx:id="myGamesBtn"
			            onAction="#handleMyGames"
			            styleClass="button"/>
			            
			    <Button text="All Games"
			            fx:id="allGamesBtn"
			            onAction="#handleAllGames"
			            styleClass="button"/>
			</VBox>
        </VBox>
    </left>

    <center>
        <VBox fx:id="main_container"
              spacing="10"
              alignment="TOP_CENTER">


        </VBox>
    </center>

</BorderPane>